# Configuration GaiaLumen
# Copiez ce fichier en .env et ajoutez vos vraies clés

# GROQ API (obtenez une clé sur https://console.groq.com/)
GROQ_API_KEY=votre_cle_groq_ici
GROQ_MODEL=llama-3.3-70b-versatile

# GaiaLumen AI Hub (optionnel)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
